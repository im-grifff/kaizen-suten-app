# Draft demo mode (no Firebase / no database)
# Leave Firebase vars empty OR set VITE_DEMO_MODE=true
VITE_DEMO_MODE=true

# Firebase (optional; only needed when you are ready to use real Phone Auth + Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Customer Relation WhatsApp number (digits only, include country code; default: 62...)
VITE_CR_WA_NUMBER=

# Nomor WhatsApp tombol pada hasil taksasi. Kalau kosong, kode memakai
# nilai bawaan di src/lib/contact.js. Isi berbeda bila bengkel dan sales dipisah.
VITE_WA_BENGKEL=6282197222519
VITE_WA_SALES=6282197222519

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roleIs(r) {
      return signedIn() && request.auth.token.role == r;
    }
    function roleIn(list) {
      return signedIn() && (request.auth.token.role in list);
    }
    function isRoot() {
      return roleIs('root');
    }

    // App pelanggan: Anonymous Auth — token sering TIDAK memenuhi `role == null` seperti di dokumentasi.
    // Gunakan provider `anonymous` eksplisit, atau tidak ada claim `role` (fallback).
    function isAnonymousProvider() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function hasNoRoleClaim() {
      return signedIn() && !request.auth.token.keys().hasAny(['role']);
    }
    function isCustomerApp() {
      return isAnonymousProvider() || hasNoRoleClaim() || request.auth.token.role == null;
    }

    function isCustomerSelf(uid) {
      return signedIn() && request.auth.uid == uid && isCustomerApp();
    }

    function plateSessionDoc() {
      return get(/databases/$(database)/documents/plate_sessions/$(request.auth.uid));
    }

    function canReadUserByPlateSession(uid) {
      return exists(/databases/$(database)/documents/plate_sessions/$(request.auth.uid))
        && plateSessionDoc().data.targetUid == uid;
    }

    function canReadUserByPlateIndex(uid) {
      return signedIn()
        && isCustomerApp()
        && exists(/databases/$(database)/documents/plate_index/$(uid))
        && get(/databases/$(database)/documents/plate_index/$(uid)).data.uid == uid;
    }

    function waSessionWaKey() {
      return get(/databases/$(database)/documents/wa_sessions/$(request.auth.uid)).data.waKey;
    }

    function tradeinReadableByWaSession() {
      return isCustomerApp()
        && exists(/databases/$(database)/documents/wa_sessions/$(request.auth.uid))
        && resource.data.customerWaKey == waSessionWaKey();
    }

    match /users/{uid} {
      allow read, write: if isRoot() || roleIn(['supervisor', 'aftersales']) || isCustomerSelf(uid);
      allow read: if canReadUserByPlateIndex(uid);
      allow read: if canReadUserByPlateSession(uid) && isCustomerApp();
    }

    match /pricelist/{id} {
      allow read: if signedIn();
      allow write: if isRoot() || roleIs('supervisor');
    }

    match /tshop_products/{id} {
      allow read: if signedIn();
      allow write: if isRoot() || roleIs('aftersales');
    }

    match /tshop_orders/{id} {
      allow read: if isRoot() || roleIs('aftersales');
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isRoot() || roleIs('aftersales');
    }

    match /wa_sessions/{uid} {
      allow read: if isRoot() || (isCustomerApp() && request.auth.uid == uid);
      allow create, update: if isCustomerApp()
        && request.auth.uid == uid
        && request.resource.data.waKey is string
        && request.resource.data.waKey.size() >= 11
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2;
      allow delete: if isCustomerApp() && request.auth.uid == uid;
    }

    match /wa_customers/{waKey} {
      allow create: if isCustomerApp()
        && waKey == request.resource.data.waKey
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && waKey.size() >= 11;
      // Baca: tanpa OTP, user yang nomor WA-nya sudah terdaftar harus bisa `get` dokumen ini
      // saat UID anon baru (belum ada wa_sessions). Memaksa cocok dengan wa_sessions dulu
      // memblokir login ulang / perangkat lain. Data di dokumen ini terbatas (nama tampilan).
      allow read: if isCustomerApp();
      allow update: if false;
    }

    // Index plat → request trade-in. Doc ID = plateKey (canonical, UPPER tanpa spasi).
    // Dipakai untuk memastikan satu plat hanya bisa diinput sekali.
    match /tradein_plate_index/{plateKey} {
      allow read: if signedIn();
      allow create: if isCustomerApp()
        && request.resource.data.plateKey == plateKey
        && request.resource.data.customerUid == request.auth.uid
        && exists(/databases/$(database)/documents/wa_sessions/$(request.auth.uid))
        && request.resource.data.customerWaKey
          == get(/databases/$(database)/documents/wa_sessions/$(request.auth.uid)).data.waKey;
      allow update, delete: if isRoot() || roleIn(['tradein', 'supervisor']);
    }

    match /tradein_requests/{id} {
      allow read: if isRoot()
        || roleIn(['tradein', 'supervisor', 'aftersales'])
        || tradeinReadableByWaSession();
      allow create: if isCustomerApp()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerWaKey is string
        && exists(/databases/$(database)/documents/wa_sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/wa_sessions/$(request.auth.uid)).data.waKey
          == request.resource.data.customerWaKey;
      allow update: if isRoot() || roleIn(['tradein', 'supervisor']);
      // Customer boleh menekan "Request Inspeksi" dari app-nya:
      // hanya untuk memindahkan stage `new` → `contacted` dan hanya jika estimasi admin sudah ada.
      allow update: if isCustomerApp()
        && exists(/databases/$(database)/documents/wa_sessions/$(request.auth.uid))
        && resource.data.customerWaKey
          == get(/databases/$(database)/documents/wa_sessions/$(request.auth.uid)).data.waKey
        && (resource.data.adminStage == 'new' || !('adminStage' in resource.data))
        && request.resource.data.adminStage == 'contacted'
        && request.resource.data.status == 'contacted'
        && (
          (resource.data.estimateLow is number && resource.data.estimateLow > 0)
          || (resource.data.estimateHigh is number && resource.data.estimateHigh > 0)
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['adminStage', 'status', 'customerRequestedInspectionAt']);
    }

    match /registration_requests/{id} {
      allow read, update: if isRoot() || roleIn(['supervisor', 'aftersales']);
      allow create: if isCustomerApp()
        && request.resource.data.plateNumber is string
        && request.resource.data.plateNumber.size() > 0
        && request.resource.data.status == 'new';
    }

    match /model_types/{model} {
      allow read: if signedIn();
      allow write: if isRoot();
    }

    match /plate_index/{plate} {
      allow read: if signedIn() && isCustomerApp();
      allow read: if isRoot() || roleIn(['supervisor', 'aftersales']);
      allow write: if isRoot() || roleIn(['supervisor', 'aftersales']);
    }

    match /plate_sessions/{uid} {
      allow read: if isRoot() || (isCustomerApp() && request.auth.uid == uid);
      allow create, update: if isCustomerApp()
        && request.auth.uid == uid
        && request.resource.data.plate is string
        && request.resource.data.targetUid is string
        && get(/databases/$(database)/documents/plate_index/$(request.resource.data.plate)).data.uid == request.resource.data.targetUid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
